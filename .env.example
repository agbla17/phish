# Set these values in the server process environment; server.js does not load .env files.
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ML_INFER_URL=http://127.0.0.1:5001
ML_TIMEOUT_MS=8000
# Optional: absolute path to the Python executable
PYTHON=
# Set to 1 only when running the ML service separately
SKIP_ML_SERVER=0
